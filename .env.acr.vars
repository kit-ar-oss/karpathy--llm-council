# Default Azure Container Registry (ACR) image naming for Compose builds.
# Safe to commit (no secrets).
#
# Override any of these at runtime, e.g.:
#   ACR_LOGIN_SERVER="myacr.azurecr.io" ACR_REPO="myteam/llm-council" IMAGE_TAG="v0.1.0" make push-acr

ACR_LOGIN_SERVER=example.azurecr.io
ACR_REPO=example/llm-council
IMAGE_TAG=latest
